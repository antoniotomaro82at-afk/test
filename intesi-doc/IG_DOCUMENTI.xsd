        <xs:restriction base="xs:string">
            <xs:minLength value="1"></xs:minLength>
            <xs:maxLength value="100"></xs:maxLength>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="NumProtType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{7,100}" />
        </xs:restriction>
    </xs:simpleType>
